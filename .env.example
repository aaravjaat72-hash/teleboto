# ============================================================================
# STANDALONE TELEGRAM BOT + 2GB MTPROTO USERBOT ENVIRONMENT VARIABLES
# ============================================================================

# Server health-check port (Render sets this automatically; defaults to 3000 locally)
PORT="3000"

# Public URL where this bot is hosted (optional, for self-ping / keep-alive)
APP_URL=""

# 1. Telegram Bot Token (from @BotFather) - REQUIRED
TELEGRAM_BOT_TOKEN=""

# 2. Default Telegram Chat / Channel ID (from @userinfobot)
TELEGRAM_CHAT_ID=""

# 2b. Main Admin Telegram numeric user ID (controls users and access codes)
# Replace the fallback value with your own numeric Telegram user ID.
MAIN_ADMIN_ID="7581137308"

# 2c. Optional shared group/channel for large MTProto uploads
# Use the numeric ID, usually -100xxxxxxxxxx. Add both Bot and Userbot there.
TELEGRAM_UPLOAD_CHAT_ID=""

# 3. Telegram MTProto API ID & API Hash (from https://my.telegram.org)
# Required for uploading large videos (> 50 MB up to 2 GB) at turbo speed
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# 4. Telegram GramJS MTProto StringSession (generated via /login or userbot login)
TELEGRAM_STRING_SESSION=""

# 5. Optional Second Telegram MTProto Account (doubles parallel upload sockets to 24)
EXTRA_TELEGRAM_API_ID=""
EXTRA_TELEGRAM_API_HASH=""
EXTRA_TELEGRAM_STRING_SESSION=""

# 6. Optional Gemini API Key (only if using AI helper commands in bot)
GEMINI_API_KEY=""

# 7. Optional free-host turbo tuning (bounded by the bot for stability)
TURBO_HLS_WORKERS="32"
TURBO_RANGE_WORKERS="24"
TURBO_UPLOAD_SOCKETS="8"
